# Production Environment Configuration
# CRITICAL: All values must be set via secure secrets management (Vault, AWS Secrets Manager, etc.)
# Never commit production credentials to version control
NODE_ENV=production
LOG_LEVEL=WARN
WEB_HOST=0.0.0.0
WEB_PORT=5000
DATABASE_PATH=/app/data/ecom.db

# Rate Limiting (strict for production)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# Circuit Breaker (strict for production)
CIRCUIT_BREAKER_THRESHOLD=5
CIRCUIT_BREAKER_TIMEOUT=60

# Slack Notifications (via secrets)
SLACK_WEBHOOK_URL=${SLACK_WEBHOOK_URL_PROD}

# SMTP Configuration (via secrets)
SMTP_SERVER=${SMTP_SERVER_PROD}
SMTP_PORT=${SMTP_PORT_PROD}
SMTP_USER=${SMTP_USER_PROD}
SMTP_PASSWORD=${SMTP_PASSWORD_PROD}

# Alert Configuration (via secrets)
ALERT_EMAIL=${ALERT_EMAIL_PROD}

# Production-specific features
ENABLE_DEBUG_LOGGING=false
ENABLE_PERFORMANCE_TRACING=false
DATABASE_BACKUP_RETENTION_DAYS=30

# Monitoring (strict for production)
MONITORING_ENABLED=true
PROMETHEUS_PORT=9090

# Security hardening
ENABLE_SECURITY_HEADERS=true
ENABLE_CORS_RESTRICTION=true
ALLOWED_ORIGINS=ecom-ops.example.com,api.ecom-ops.example.com

# Request timeout (production-safe)
REQUEST_TIMEOUT_MS=30000

# TLS/HTTPS enforcement
ENFORCE_HTTPS=true
TLS_MIN_VERSION=1.2

# Health check configuration
HEALTH_CHECK_INTERVAL_SECONDS=10
HEALTH_CHECK_TIMEOUT_SECONDS=5

# Graceful shutdown
GRACEFUL_SHUTDOWN_TIMEOUT_MS=30000
