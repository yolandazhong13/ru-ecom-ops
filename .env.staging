# Staging Environment Configuration
NODE_ENV=staging
LOG_LEVEL=INFO
WEB_HOST=0.0.0.0
WEB_PORT=5000
DATABASE_PATH=/app/data/ecom.db

# Rate Limiting (moderate for staging)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=500
RATE_LIMIT_WINDOW=60

# Circuit Breaker (moderate for staging)
CIRCUIT_BREAKER_THRESHOLD=8
CIRCUIT_BREAKER_TIMEOUT=45

# Slack Notifications
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/STAGING/WEBHOOK/URL

# SMTP Configuration
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-staging-email@gmail.com
SMTP_PASSWORD=your-app-password

# Alert Configuration
ALERT_EMAIL=staging-alerts@example.com

# Docker Compose overrides
WEB_PORT=5000

# Monitoring
MONITORING_ENABLED=true
PROMETHEUS_PORT=9090

# Staging-specific features
ENABLE_DEBUG_LOGGING=false
ENABLE_PERFORMANCE_TRACING=true
DATABASE_BACKUP_RETENTION_DAYS=7
